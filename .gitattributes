# Normalize every text file to LF in the repository, and check it out as LF
# on every platform. `eol=lf` overrides a contributor's core.autocrlf, so a
# Windows clone no longer reports "LF will be replaced by CRLF".
* text=auto eol=lf

# Binary assets — never touch the bytes.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary

# Generated lockfiles: collapsed on GitHub, still a normal text diff locally.
package-lock.json  linguist-generated
