# METIS Environment Configuration
# Copy this to .env and fill in your values

# Google Cloud
# Setting GOOGLE_CLOUD_PROJECT is what switches the app from local SQLite to
# Firestore. Leave it blank to develop with no Google account at all.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# The same key, inlined on one line, for hosts that have no metadata server
# and no file to mount (Hugging Face Spaces, Render, any plain container).
# Set this OR the path above, not both -- a real file always wins.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

GEMINI_API_KEY=your-gemini-api-key

# Authentication (Milestone 8)
# Off by default: a local single-user install has nobody to sign in as.
# Turn on for any deployment reachable from the internet.
METIS_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=            # defaults to GOOGLE_CLOUD_PROJECT when blank

# Local storage
METIS_DB_PATH=                  # override the SQLite path (tests / E2E use a clean copy)

# Refuse to fall back to SQLite when Firestore was asked for and did not
# answer. Off here, where falling back is the point. Turn on wherever the
# filesystem is thrown away on restart -- otherwise the app keeps serving,
# looks healthy, and loses every order the next time it wakes up.
METIS_REQUIRE_FIRESTORE=false

# Demo mode: answer agent chats deterministically without a Gemini key
METIS_MOCK_AI=false

# Application
DEBUG=true
# Either spelling works: a JSON array, or a plain comma-separated list for
# hosting dashboards that only give you one text box.
CORS_ORIGINS=["http://localhost:3000"]
