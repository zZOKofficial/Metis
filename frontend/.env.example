# METIS Frontend — build-time configuration
# NEXT_PUBLIC_* values are inlined into the client bundle when you build.

# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Firebase Authentication (Milestone 8).
# Leave blank for local development: the app then runs unauthenticated, which
# matches METIS_AUTH_ENABLED=false on the backend. Set all three to require
# sign-in — the owner pages gate on it, the public storefront never does.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
